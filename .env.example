# Пароли и ключи — реальные значения только в .env (в git не входит).
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
# Межсервисный ключ: = SERVICE_API_KEY аналитики, эмбеддера и парсеров
PARSER_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Необязательные настройки: без строки берётся значение по умолчанию из application.yaml.
# Размер ниши
NICHE_TARGET_COUNT=10
NICHE_PLAN_COUNT=10
# Медленные категории: карточка в обходе не чаще раза в N часов
MONITORING_SLOW_CATEGORIES=clothing
MONITORING_SLOW_MIN_INTERVAL_HOURS=24
# Снимки поисковой выдачи (время МСК) и окно прогона в минутах
SEARCH_SNAPSHOT_ENABLED=true
SEARCH_SNAPSHOT_SCHEDULE=kids_clothing=18:37
SEARCH_SNAPSHOT_SPREAD_MINUTES=240